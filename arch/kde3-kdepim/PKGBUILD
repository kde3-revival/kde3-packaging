# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# kdepim 3.5.10 as maintained by kde3-revival, installed in /opt/kde3.
# Snapshot of a fixed commit; run ../../bump.sh kde3-kdepim to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).
#
# kde3-qt, kde3-kdelibs and kde3-kdebase are not in a repository: build
# them first (../../build.sh does that with the packages in out/).

pkgname=kde3-kdepim
# the GitHub repository; its tarballs unpack to kde3-pim-<commit>
_repo=kde3-pim
_commit=b9a81785c6af3c8363150880b59235e86d2a2c20
_date=20261126
pkgver=3.5.10+git${_date}
pkgrel=1
pkgdesc='KDE 3.5 PIM suite (KMail, KOrganizer, KAddressBook, Kontact, Kleopatra) maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-pim'
license=('GPL-2.0-or-later AND LGPL-2.0-or-later AND (LGPL-2.1-only OR MPL-1.0) AND GFDL-1.2-or-later')
# kde3-kdebase: the ioslaves KMail and KAddressBook use for POP3, SMTP and
# LDAP (kio_pop3, kio_smtp, kio_ldap; imap4, sieve and mbox are kdepim's
# own).  gnupg (gpg, gpgsm, gpg-agent, pinentry) is run by the crypto
# backends of KMail and Kleopatra, through gpgme and, for the classic
# OpenPGP support of KMail (libkpgp), directly.  perl runs ical2vcal and
# kconf_update scripts (and generates libical's sources at build time).
# glib2: KMail disconnects before the machine sleeps (logind, GIO).
# KMail's new-mail balloon is a KBalloon (kdelibs since 2026-11-24).
depends=(kde3-kdebase 'kde3-kdelibs>=3.5.10+git20261124' kde3-qt glib2 glibc gnupg gpgme libgcc
         libgpg-error libsasl libstdc++ libx11 perl zlib)
makedepends=(cmake ninja)
# kde3-wpepart: KMail's reader shows messages with WPE WebKit (its mail
# mode, kde3-wpepart 0.1.0+git20261123 or later); without it, with KHTML.
optdepends=('kde3-wpepart>=0.1.0+git20261123: KMail reader with WPE WebKit (else KHTML)'
            'spamassassin: spam filtering (KMail anti-spam wizard)'
            'clamav: virus filtering (KMail anti-virus wizard)')
source=("kde3-kdepim-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('13bd8a8c66e59cd28c96a73293936f1f11a09b9242bfc396d54adfe88242c835')

_prefix=/opt/kde3

build() {
  # The prefix, the library directory (/opt/kde3/lib) and the RUNPATH come
  # from kdelibs' CMake package.  CMAKE_BUILD_TYPE=None: the distribution
  # flags only.  cyrus-sasl is required (the sieve ioslave, the
  # authentication methods of imap4); gnokii (mobile phones in
  # KAddressBook) is not in Arch, indexlib (KMail's full-text index) is
  # experimental and off by default.  KDEPIM_WITH_LOGIND: KMail listens
  # to logind's PrepareForSleep (GIO; auto-detected by default).
  cmake -S ${_repo}-${_commit} -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DKDEPIM_WITH_SASL=ON \
    -DKDEPIM_WITH_GNOKII=OFF \
    -DKDEPIM_INDEXLIB=OFF \
    -DKDEPIM_WITH_LOGIND=ON
  grep -qx "CMAKE_INSTALL_PREFIX:PATH=${_prefix}" build/CMakeCache.txt ||
    { error "configure: install prefix is not ${_prefix}"; return 1; }
  # Fail instead of silently building without an optional feature.
  local have
  for have in HAVE_LIBSASL2 HAVE_INOTIFY HAVE_GPGME_0_4_BRANCH HAVE_GPGME_CANCEL \
              HAVE_GPGME_INCLUDE_CERTS_DEFAULT HAVE_GPGME_KEYLIST_MODE_VALIDATE \
              HAVE_GPGME_KEY_T_KEYLIST_MODE HAVE_GPGME_OP_GETAUDITLOG \
              HAVE_GPGME_WRONG_KEY_USAGE KDEPIM_NEW_DISTRLISTS HAVE_GIO_UNIX; do
    grep -q "^#define $have 1" build/config.h || { error "configure: $have not set"; return 1; }
  done
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  local src=${_repo}-${_commit} root=${pkgdir}${_prefix}

  # Parts that are only built when their dependencies are found.
  local f
  for f in bin/kmail bin/korganizer bin/kaddressbook bin/kontact bin/kleopatra \
           lib/kde3/kio_imap4.so lib/kde3/kio_sieve.so lib/kde3/kio_mbox.so; do
    [[ -e ${root}/$f ]] || { error "not built: $f"; return 1; }
  done

  # The service of the gnokii filter is installed although its module is
  # only built with gnokii: KAddressBook would offer an import/export it
  # cannot load.
  rm "${root}/share/services/kaddressbook/gnokii_xxport.desktop"

  install -Dm644 ${src}/korganizer/COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
  install -Dm644 ${src}/libkcal/COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB"
  install -Dm644 ${src}/kontact/pics/icons/LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.kontact-icons"
}
