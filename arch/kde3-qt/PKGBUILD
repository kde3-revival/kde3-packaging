# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# Qt 3.3.8b as maintained by kde3-revival, installed in /opt/kde3-qt.
# Snapshot of a fixed commit; run ../../bump.sh kde3-qt to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).

pkgbase=kde3-qt
pkgname=(kde3-qt kde3-qt-designer kde3-qt-doc)
_commit=b2b4572a3956472ef1a6187e43c7623f39019b2c
_date=20261120
pkgver=3.3.8b+git${_date}
pkgrel=1
pkgdesc='Qt 3 toolkit maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-qt'
license=('GPL-2.0-only OR GPL-3.0-only OR QPL-1.0')
makedepends=(libcups fontconfig freetype2 glu libgl libice libjpeg-turbo libmng
             libpng libsm libx11 libxcursor libxext libxft libxi libxinerama
             libxmu libxrandr libxrender zlib patchelf libgcc libstdc++)
source=("kde3-qt-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz"
        kde3-qt.sh
        kde3-qt.csh)
sha256sums=('adab7493644ab7b8b562b50b0d9c68773e19052cfc583dc5f6af11c23f1ee5df'
            'cb5a4e10ed247eed92d91df6135618370b230f684af7bad6dba44911660126cf'
            '9fb71a7f15ea58a1d63ccdfd6a25d5b938c1e65653e4bbd23ca8df1327dbab1d')

_prefix=/opt/kde3-qt

# Replace the value of a variable in a qmake.conf.
_setvar() {
  sed -i "s|^\($1[[:space:]]*\)=.*|\1= $2|" "$3"
}

# Build with the distribution flags (makepkg adds the debug and LTO flags
# only after prepare(), so this is done in build()) and without qmake's own
# stripping (makepkg strips and splits the debug info).  The flags go into
# the base variables, which are also used for the bootstrap qmake.  The
# pristine qmake.conf is installed, so that programs built later against
# this Qt do not inherit them.
_setflags() {
  local conf=mkspecs/linux-g++/qmake.conf
  [[ -f ${srcdir}/qmake.conf.pristine ]] || cp $conf "${srcdir}/qmake.conf.pristine"
  # Some debug output still passes a non-literal format to qDebug() (e.g.
  # QGDict::statistics()); keep -Wformat-security as a warning until that
  # is fixed upstream.
  _setvar QMAKE_CFLAGS           "${CFLAGS} -Wno-error=format-security"   $conf
  _setvar QMAKE_CXXFLAGS         "${CXXFLAGS} -Wno-error=format-security" $conf
  _setvar QMAKE_CFLAGS_RELEASE   ""            $conf
  _setvar QMAKE_CXXFLAGS_RELEASE ""            $conf
  _setvar QMAKE_LFLAGS           "${LDFLAGS}"  $conf
  _setvar QMAKE_STRIP            ""            $conf
}

# The tools get a RUNPATH to the install location only, but uic runs during
# the build (and "make install" may run it again).
_buildenv() {
  export LD_LIBRARY_PATH="${srcdir}/kde3-qt-${_commit}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
}

build() {
  cd kde3-qt-${_commit}
  _setflags
  _buildenv
  # configure asks to accept the license (GPL 2/3 or QPL); there is no
  # option for that, so answer on stdin.
  echo yes | ./configure -prefix ${_prefix}
  # configure disables features silently when a test fails; make sure the
  # build has what kde3-revival needs.
  local feature
  for feature in opengl cups xinerama xcursor xrandr xrender xftfreetype tablet; do
    grep -q "^CONFIG +=.* $feature\b" .qmake.cache || { error "configure: $feature not enabled"; return 1; }
  done
  # The library, plugins and tools; "make" alone would also build the
  # tutorial and the examples, which are not packaged.
  make sub-tools
}

# Move a path (relative to the package root) from the kde3-qt package to the
# staging tree of another split package.
_stage() {
  local dest=$1; shift
  local p
  for p in "$@"; do
    [[ -e ${pkgdir}/$p || -L ${pkgdir}/$p ]] || { error "missing: $p"; return 1; }
    mkdir -p "${srcdir}/stage-${dest}/$(dirname "$p")"
    mv "${pkgdir}/$p" "${srcdir}/stage-${dest}/$p"
  done
}

package_kde3-qt() {
  pkgdesc='Qt 3 toolkit maintained for kde3-revival (libraries, plugins, headers and tools)'
  # libcups is loaded at run time (QLibrary) by the print dialog; glu is
  # linked by programs built with CONFIG += opengl.
  depends=(fontconfig freetype2 glibc glu libcups libgcc libgl libice
           libjpeg-turbo libmng libpng libsm libstdc++ libx11 libxcursor
           libxext libxft libxi libxinerama libxmu libxrandr libxrender zlib)
  optdepends=('kde3-qt-designer: Qt Designer, Qt Assistant and Qt Linguist'
              'kde3-qt-doc: HTML and man page documentation')

  cd kde3-qt-${_commit}
  _buildenv
  make INSTALL_ROOT="${pkgdir}" install

  local root=${pkgdir}${_prefix}
  local build=${srcdir}/kde3-qt-${_commit}

  # The pristine mkspec (see _setflags()).
  install -m644 "${srcdir}/qmake.conf.pristine" "${root}/mkspecs/linux-g++/qmake.conf"

  # qmake's install rule points mkspecs/default at the build tree (and, as
  # the copied tree already has a "default" link, ln -sf puts that link
  # inside linux-g++/).  Make it a relative link to the spec.
  rm -f "${root}/mkspecs/linux-g++/linux-g++"
  ln -sfn linux-g++ "${root}/mkspecs/default"

  # qmake gives the programs a RUNPATH to the install location and every
  # library and plugin one to its build directory (DESTDIR).  Map the build
  # directory to the install location and make all entries relative to
  # $ORIGIN (an absolute /opt RUNPATH is rejected by Fedora's check-rpaths
  # and flagged as insecure by namcap).
  local f rp new e dir
  while IFS= read -r -d '' f; do
    rp=$(patchelf --print-rpath "$f" 2>/dev/null) || continue
    [[ -n $rp ]] || continue
    dir=$(dirname "${f#${pkgdir}}")
    new=
    for e in ${rp//:/ }; do
      [[ $e == "${build}"* ]] && e=${_prefix}${e#${build}}
      if [[ $e == "${_prefix}"* ]]; then
        e=$(realpath -m --relative-to="$dir" "$e")
        [[ $e == . ]] && e='$ORIGIN' || e='$ORIGIN/'$e
      fi
      [[ :$new: == *:"$e":* ]] || new=${new:+$new:}$e
    done
    patchelf --set-rpath "$new" "$f"
  done < <(find "${root}" -type f \( -name '*.so*' -o -perm -u+x \) -print0)

  # The .prl files (read by qmake's link_prl) record the build directory.
  sed -i -e '/^QMAKE_PRL_BUILD_DIR/d' -e "s|-L${build}/lib|-L${_prefix}/lib|g" "${root}"/lib/*.prl

  # libtool archives are not used.
  rm -f "${root}"/lib/*.la

  # Man pages are not installed by "make install"; /opt/kde3-qt/man is found
  # by man(1) through PATH.
  install -Dm644 -t "${root}/man/man1" doc/man/man1/*.1

  # Environment and pkg-config.
  install -Dm644 "${srcdir}/kde3-qt.sh"  "${pkgdir}/etc/profile.d/kde3-qt.sh"
  install -Dm644 "${srcdir}/kde3-qt.csh" "${pkgdir}/etc/profile.d/kde3-qt.csh"
  install -dm755 "${pkgdir}/usr/lib/pkgconfig"
  ln -s ../../..${_prefix}/lib/pkgconfig/kde3-qt.pc "${pkgdir}/usr/lib/pkgconfig/kde3-qt.pc"

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" LICENSE.GPL2 LICENSE.GPL3 LICENSE.QPL

  # Split the GUI development tools and the documentation off.
  local p=${_prefix#/}
  _stage designer \
    $p/bin/{designer,assistant,linguist} \
    $p/plugins/designer \
    $p/templates \
    $p/phrasebooks \
    $p/translations/assistant_de.qm
  _stage doc $p/doc
  install -Dm644 -t "${srcdir}/stage-doc/$p/man/man3" doc/man/man3/*.3qt
}

package_kde3-qt-designer() {
  pkgdesc='Qt 3 Designer, Assistant and Linguist (kde3-revival)'
  depends=("kde3-qt=${pkgver}-${pkgrel}" glibc libgcc libstdc++)
  optdepends=('kde3-qt-doc: documentation browsed with Qt Assistant')
  mv "${srcdir}/stage-designer"/* "${pkgdir}/"
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    kde3-qt-${_commit}/{LICENSE.GPL2,LICENSE.GPL3,LICENSE.QPL}
}

package_kde3-qt-doc() {
  pkgdesc='Qt 3 HTML documentation and man pages (kde3-revival)'
  arch=(any)
  mv "${srcdir}/stage-doc"/* "${pkgdir}/"
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    kde3-qt-${_commit}/{LICENSE.GPL2,LICENSE.GPL3,LICENSE.QPL}
}
