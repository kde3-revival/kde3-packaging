package_kde3-kdf() {
  pkgdesc='Disk space viewer for KDE 3.5, with KwikDisk and a Control Center module (kde3-revival)'
  license=('GPL-2.0-or-later AND GFDL-1.1-or-later')
  # KDiskFree runs df, and mounts and unmounts through udisksctl.
  depends=("${_kdedeps[@]}" coreutils)
  optdepends=('udisks2: mounting and unmounting disks as a normal user')
  conflicts=("kde3-kdeutils<${_replaced}")
  local _files=(bin/kdf bin/kwikdisk lib/kde3/kcm_kdf.so)
  _install kdf doc/kinfocenter
}

