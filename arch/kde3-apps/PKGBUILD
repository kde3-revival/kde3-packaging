package_kde3-ksnapshot() {
  pkgdesc='Screen capture program for KDE 3.5 (kde3-revival)'
  license=('GPL-2.0-or-later AND LGPL-2.0-or-later AND GFDL-1.1-or-later')
  # libxext: the Shape extension (shaped windows cut to their shape).
  depends=("${_kdedeps[@]}" libx11 libxext)
  # KWin's screenshot shortcuts (Print, Shift+Print, Alt+Print) run
  # KSnapshot.
  optdepends=('kde3-kdebase: the Print key takes screenshots with KSnapshot (KWin)')
  conflicts=("kde3-kdegraphics<${_replaced}")
  local _files=(bin/ksnapshot)
  _install ksnapshot
}

package_kde3-kweather() {
  pkgdesc='Weather applet of the KDE 3.5 panel, forecasts from Open-Meteo (kde3-revival)'
  license=('GPL-2.0-or-later AND GFDL-1.1-or-later')
  depends=("${_kdedeps[@]}")
  # the applet runs in kicker
  optdepends=('kde3-kdebase: the panel (kicker) the applet runs in')
  local _files=(bin/kweatherservice lib/kde3/weather_panelapplet.so lib/kde3/kcm_weather.so)
  _install kweather
}

package_kde3-kbluetooth() {
  pkgdesc='Bluetooth applet of the KDE 3.5 system tray, on BlueZ 5 (kde3-revival)'
  license=('GPL-2.0-or-later AND GFDL-1.1-or-later')
  # bluez: bluetoothd, over the system D-Bus (GIO)
  depends=("${_kdedeps[@]}" bluez glib2)
  local _files=(bin/kbluetooth share/autostart/kbluetooth.desktop)
  _install kbluetooth
}
