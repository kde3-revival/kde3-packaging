# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# kde3-apps (the applications of kdeutils and kdegraphics 3.5.10 as
# maintained by kde3-revival), installed in /opt/kde3: one source tree,
# one package per application.
# Snapshot of a fixed commit; run ../../bump.sh kde3-apps to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).
#
# kde3-qt and kde3-kdelibs are not in a repository: build them first
# (../../build.sh does that with the packages in out/).
#
# kde3-apps replaces kde3-kdeutils and kde3-kdegraphics: the package
# kde3-apps itself (all applications) replaces them, so "pacman -Syu"
# installs every application they had; each application's package
# conflicts with the old package that held its files.

pkgbase=kde3-apps
pkgname=(kde3-apps kde3-ark kde3-kcalc kde3-kcharselect kde3-kdf kde3-khexedit
         kde3-ktimer kde3-kwalletmanager kde3-kview kde3-kruler kde3-ksnapshot
         kde3-kweather kde3-kbluetooth)
_commit=75557fb855cddbfed4962ec7b4b9d796b7191316
_date=20261123
pkgver=3.5.10+git${_date}
pkgrel=2
pkgdesc='KDE 3.5 applications (Ark, KCalc, KView, KSnapshot, KWeather, ...) maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-apps'
license=('GPL-2.0-or-later AND GPL-2.0-only AND LGPL-2.0-only AND LGPL-2.0-or-later AND GFDL-1.1-or-later')
# tar, gzip and bluez: split packages need their dependencies at build
# time (namcap); glib2:
# kbluetooth talks to BlueZ with GIO's GDBus.
makedepends=(bluez cmake ninja kde3-kdelibs kde3-qt glib2 gmp gzip libx11 libxext tar)
source=("kde3-apps-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('2344bf001f9f85378e327b4ddaece7a73d6a1cecb910349e4fd52ee43dfa2519')

_prefix=/opt/kde3
# kde3-kdeutils and kde3-kdegraphics older than that are replaced
_replaced=3.5.10+git20261123
# the libraries of every application
_kdedeps=(kde3-kdelibs kde3-qt glibc libgcc libstdc++)

build() {
  # The prefix, the library directory (/opt/kde3/lib) and the RUNPATH come
  # from kdelibs' CMake package.  CMAKE_BUILD_TYPE=None: the distribution
  # flags only.  Every application is switched on explicitly
  # (KDE3_APPS_KCALC and KDE3_APPS_KSNAPSHOT_XSHAPE fail without GMP and
  # the Shape extension).
  cmake -S kde3-apps-${_commit} -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DKDE3_APPS_ARK=ON \
    -DKDE3_APPS_KCALC=ON \
    -DKDE3_APPS_KCHARSELECT=ON \
    -DKDE3_APPS_KDF=ON \
    -DKDE3_APPS_KHEXEDIT=ON \
    -DKDE3_APPS_KTIMER=ON \
    -DKDE3_APPS_KWALLET=ON \
    -DKDE3_APPS_KVIEW=ON \
    -DKDE3_APPS_KRULER=ON \
    -DKDE3_APPS_KSNAPSHOT=ON \
    -DKDE3_APPS_KSNAPSHOT_XSHAPE=ON \
    -DKDE3_APPS_KWEATHER=ON \
    -DKDE3_APPS_KBLUETOOTH=ON
  grep -qx "CMAKE_INSTALL_PREFIX:PATH=${_prefix}" build/CMakeCache.txt ||
    { error "configure: install prefix is not ${_prefix}"; return 1; }
  local have
  for have in HAVE_GMP HAVE_LONG_DOUBLE HAVE_L_FUNCS HAVE_X11_EXTENSIONS_SHAPE_H; do
    grep -q "^#define $have 1" build/config.h || { error "configure: $have not set"; return 1; }
  done
  cmake --build build
}

# _install <directory> [<more directories>]: what the install scripts of
# an application's build directory and of its handbook (doc/<directory>)
# install, checked for the given files.  libkhexeditcommon (the khexedit2
# part) and libkimageviewer (KView's parts) install no headers: their
# unversioned links are of no use.
_install() {
  local d f root=${pkgdir}${_prefix}
  for d in "$1" "doc/$1" "${@:2}"; do
    DESTDIR="${pkgdir}" cmake --install build/$d >/dev/null
  done
  for f in "${_files[@]}"; do
    [[ -e ${root}/$f ]] || { error "not built: $f"; return 1; }
  done
  rm -f "${root}"/lib/{libkhexeditcommon,libkimageviewer}.so
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    kde3-apps-${_commit}/{COPYING,COPYING-DOCS}
}

package_kde3-apps() {
  pkgdesc='KDE 3.5 applications of kde3-revival (all of them: Ark, KCalc, KCharSelect, KDiskFree, KHexEdit, KTimer, KWalletManager, KView, KRuler, KSnapshot, KWeather, kbluetooth)'
  depends=("kde3-ark=${pkgver}-${pkgrel}" "kde3-kcalc=${pkgver}-${pkgrel}"
           "kde3-kcharselect=${pkgver}-${pkgrel}" "kde3-kdf=${pkgver}-${pkgrel}"
           "kde3-khexedit=${pkgver}-${pkgrel}" "kde3-ktimer=${pkgver}-${pkgrel}"
           "kde3-kwalletmanager=${pkgver}-${pkgrel}" "kde3-kview=${pkgver}-${pkgrel}"
           "kde3-kruler=${pkgver}-${pkgrel}" "kde3-ksnapshot=${pkgver}-${pkgrel}"
           "kde3-kweather=${pkgver}-${pkgrel}" "kde3-kbluetooth=${pkgver}-${pkgrel}")
  replaces=("kde3-kdeutils<${_replaced}" "kde3-kdegraphics<${_replaced}")
  conflicts=("kde3-kdeutils<${_replaced}" "kde3-kdegraphics<${_replaced}")
  install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" kde3-apps-${_commit}/{README.md,AUTHORS}
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    kde3-apps-${_commit}/{COPYING,COPYING-DOCS}
}

package_kde3-ark() {
  pkgdesc='Archive manager for KDE 3.5 (kde3-revival)'
  license=('GPL-2.0-or-later AND GFDL-1.1-or-later')
  # Ark drives command line tools: tar, gzip and bzip2 for its basic
  # formats; the others are looked up when an archive of their kind is
  # opened.
  depends=("${_kdedeps[@]}" bzip2 gzip tar)
  optdepends=('xz: .tar.xz and .xz archives'
              'zstd: .tar.zst and .zst archives'
              'lz4: .tar.lz4 and .lz4 archives'
              'zip: creating and changing .zip archives'
              'unzip: .zip and .jar archives'
              '7zip: 7-Zip archives'
              'unrar: RAR archives (read-only)'
              'lzop: .tar.lzo and .lzo archives')
  conflicts=("kde3-kdeutils<${_replaced}")
  local _files=(bin/ark lib/kde3/libarkpart.so)
  _install ark
}

