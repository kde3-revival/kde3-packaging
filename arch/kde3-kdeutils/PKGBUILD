# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# kdeutils 3.5.10 as maintained by kde3-revival, installed in /opt/kde3.
# Snapshot of a fixed commit; run ../../bump.sh kde3-kdeutils to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).
#
# kde3-qt and kde3-kdelibs are not in a repository: build them first
# (../../build.sh does that with the packages in out/).

pkgname=kde3-kdeutils
_commit=66caeb3d93312dbc73a381e1dd8b0c833048012f
_date=20261121
pkgver=3.5.10+git${_date}
pkgrel=1
pkgdesc='KDE 3.5 utilities (Ark, KCalc, KCharSelect, KDiskFree, KHexEdit, KTimer, KWalletManager) maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-kdeutils'
license=('GPL-2.0-or-later AND LGPL-2.0-only AND LGPL-2.0-or-later AND GFDL-1.2-or-later')
# Ark drives command line tools: tar, gzip and bzip2 are needed for its
# basic formats and are in every installation anyway; the others are
# looked up when an archive of their kind is opened.  KDiskFree runs df.
depends=(kde3-kdelibs kde3-qt bzip2 coreutils glibc gmp gzip libgcc
         libstdc++ tar)
makedepends=(cmake ninja)
optdepends=('xz: .tar.xz and .xz archives in Ark'
            'zstd: .tar.zst and .zst archives in Ark'
            'lz4: .tar.lz4 and .lz4 archives in Ark'
            'zip: creating and changing .zip archives in Ark'
            'unzip: .zip and .jar archives in Ark'
            '7zip: 7-Zip archives in Ark'
            'unrar: RAR archives in Ark (read-only)'
            'lzop: .tar.lzo and .lzo archives in Ark'
            'udisks2: mounting and unmounting disks in KDiskFree as a normal user')
source=("kde3-kdeutils-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('d87028c412441838ab114e2254f9c9a5844d4fa7ff347d687c1cbb0cc40b9a16')

_prefix=/opt/kde3

build() {
  # The prefix, the library directory (/opt/kde3/lib) and the RUNPATH come
  # from kdelibs' CMake package.  CMAKE_BUILD_TYPE=None: the distribution
  # flags only.  KCalc needs GMP (KDEUTILS_BUILD_KCALC fails without it).
  cmake -S kde3-kdeutils-${_commit} -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DKDEUTILS_BUILD_KCALC=ON
  grep -qx "CMAKE_INSTALL_PREFIX:PATH=${_prefix}" build/CMakeCache.txt ||
    { error "configure: install prefix is not ${_prefix}"; return 1; }
  local have
  for have in HAVE_GMP HAVE_LONG_DOUBLE HAVE_L_FUNCS; do
    grep -q "^#define $have 1" build/config.h || { error "configure: $have not set"; return 1; }
  done
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  local src=kde3-kdeutils-${_commit} root=${pkgdir}${_prefix}

  local f
  for f in bin/ark bin/kcalc bin/kcharselect bin/kdf bin/kwikdisk bin/khexedit \
           bin/ktimer bin/kwalletmanager lib/kde3/libarkpart.so \
           lib/kde3/libkhexedit2part.so lib/kde3/kcm_kdf.so lib/kde3/kcm_kwallet.so; do
    [[ -e ${root}/$f ]] || { error "not built: $f"; return 1; }
  done

  # libkhexeditcommon is private to the khexedit2 part: no headers are
  # installed, so the unversioned link is of no use.
  rm "${root}/lib/libkhexeditcommon.so"

  install -Dm644 ${src}/COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
  install -Dm644 ${src}/COPYING-DOCS "${pkgdir}/usr/share/licenses/${pkgname}/COPYING-DOCS"
}
