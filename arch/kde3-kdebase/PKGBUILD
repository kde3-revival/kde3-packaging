# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# kdebase 3.5.10 as maintained by kde3-revival, installed in /opt/kde3.
# Snapshot of a fixed commit; run ../../bump.sh kde3-kdebase to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).
#
# kde3-qt and kde3-kdelibs are not in a repository: build them first
# (../../build.sh does that with the packages in out/).

pkgname=kde3-kdebase
# the GitHub repository; its tarballs unpack to kde3-base-<commit>
_repo=kde3-base
_commit=3af59d9cbf4c028a110223f9e3884afe30e890f9
_date=20261128
pkgver=3.5.10+git${_date}
pkgrel=4
pkgdesc='KDE 3.5 desktop (kwin, kicker, kdesktop, konqueror, konsole, kcontrol, kdm, ...) maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-base'
license=('GPL-2.0-or-later AND LGPL-2.0-or-later AND GFDL-1.2-or-later')
# The X tools are run by startkde (xrdb), kcontrol (xrdb, setxkbmap) and
# kdm (xauth; xmessage in its Xsession).  mkfontdir only makes
# fonts.dir files for core X fonts (kfontinst; at build time for Konsole's
# fonts).  glib2: ksmserver asks systemd-logind for sleep and hibernate
# (GIO); libpulse: the volume applet of kicker.  udisks2: the media
# manager lists, mounts and ejects the storage devices through it (GIO);
# upower: libupower-glib, for the power applet of kicker.  libnm: the
# network applet of kicker (NetworkManager).  KWin composites itself:
# libglvnd (EGL, GLESv2), mesa (GBM), libxcb (DRI3), libxshmfence
# for the GLES 3 backend (libdrm: only its headers, so a makedepends),
# libxpresent for tear-free frames, libxi (XInput 2.3) for the overview's
# Super key and hot corner barrier and for the touchpad settings
# (kded_touchpad).
depends=(kde3-kdelibs kde3-qt avahi fontconfig freetype2 glib2
         glibc glu libgcc libgl libglvnd libice libldap libnm libpulse
         libsasl libsm libstdc++ libusb-compat libx11 libxau libxcb
         libxcomposite libxcursor libxdamage libxdmcp libxext libxfixes libxft
         libxi libxinerama libxkbfile libxpresent libxrandr libxrender
         libxshmfence libxss libxtst lm_sensors mesa openexr openssl pam
         perl smbclient udisks2 upower zlib
         xorg-setxkbmap xorg-xauth xorg-xmessage xorg-xrdb)
makedepends=(cmake libdrm ninja xorg-bdftopcf xorg-mkfontscale)
optdepends=('gdb: backtraces in the crash handler (DrKonqi)'
            'xorg-mkfontscale: fonts.dir for core X fonts installed with kfontinst'
            'networkmanager: the network applet of kicker'
            'nm-connection-editor: settings of the network applet (802.1X, WEP)'
            'xdg-desktop-portal-gtk: file chooser, settings and other portals (kde3-portals.conf)'
            'gnome-keyring: passwords of Chromium and Electron applications (libsecret), secret portal'
            "dconf: the session's own GSettings database (KDE's fonts and colours for GTK)"
            'xorg-server: to run kdm'
            'kde3-ksnapshot: screenshots with the Print key (KWin)')
backup=(etc/pam.d/kde3
        etc/pam.d/kde3-np
        opt/kde3/share/config/kdm/kdmrc
        opt/kde3/share/config/kdm/backgroundrc
        opt/kde3/share/config/kdm/Xaccess
        opt/kde3/share/config/kdm/Xreset
        opt/kde3/share/config/kdm/Xsession
        opt/kde3/share/config/kdm/Xsetup
        opt/kde3/share/config/kdm/Xstartup
        opt/kde3/share/config/kdm/Xwilling)
source=("kde3-kdebase-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz"
        kde3.pam
        kde3-np.pam
        kde3.desktop
        kde3-kdm.service)
sha256sums=('4d0cef39d16b1c63cf4c1dd08b4fdd34326cb88540275c521714a4d35879c8d6'
            '6553fec18adaadec5e3e8a9c5f1c1640a0a029caa0b3d19a7c9448214848d4ce'
            '971b0fa0177567ccd0864b0832f4f06b7f9d6813db8aa9054c8a5821f108f5cf'
            'f0150f739ff3d1550decc7279bb4da8fab94b2d609aadecaf87422e64301086f'
            '3b7c70b3e48cfa9077ee6740458bf479b4f7a77e61caf23545babbb4256a3c54')

_prefix=/opt/kde3

build() {
  # The prefix, the library directory (/opt/kde3/lib) and the RUNPATH come
  # from kdelibs' CMake package.  CMAKE_BUILD_TYPE=None: the distribution
  # flags only.  PAM service "kde3" (and "kde3-np" for logins without
  # password) instead of the default "kde", which is KDE Plasma's
  # (kscreenlocker).  GENKDMCONF_FLAGS stays empty: genkdmconf gets --no-old
  # in a DESTDIR installation, so that the kdm configuration does not take
  # over the build machine's.
  cmake -S ${_repo}-${_commit} -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DKDE3_PAM=kde3 \
    -DKDE3_WITH_SENSORS=ON \
    -DKDE3_WITH_SAMBA=ON \
    -DKDE3_WITH_OPENEXR=ON \
    -DKDE3_WITH_LIBUSB=ON \
    -DKDEBASE_KONSOLE_FONTS=ON \
    -DKDEBASE_VOLUME_APPLET=ON \
    -DKDEBASE_LOGIND_SLEEP=ON \
    -DKDEBASE_UDISKS2=ON \
    -DKDEBASE_POWER_APPLET=ON \
    -DKDEBASE_NETWORK_APPLET=ON \
    -DKDEBASE_SYSTRAY_SNI=ON \
    -DKDEBASE_SETTINGS_PORTAL=ON
  grep -qx "CMAKE_INSTALL_PREFIX:PATH=${_prefix}" build/CMakeCache.txt ||
    { error "configure: install prefix is not ${_prefix}"; return 1; }
  # Fail instead of silently building without an optional feature.
  local have
  for have in HAVE_PAM HAVE_SSL HAVE_XCOMPOSITE HAVE_XINERAMA HAVE_DPMS \
              HAVE_LIBSASL2 HAVE_XSCREENSAVER HAVE_DNSSD HAVE_SENSORS_SENSORS_H \
              HAVE_LIBUSB HAVE_XKB HAVE_XFT HAVE_XRENDER HAVE_XCURSOR HAVE_XTEST \
              HAVE_XFIXES HAVE_LOGIND_SLEEP COMPILE_UDISKS2BACKEND \
              HAVE_XDAMAGE HAVE_XPRESENT KWIN_PANORAMIX_CHECK KWIN_OVERVIEW_XI2 \
              KWIN_HAVE_GLES HAVE_STATUSNOTIFIER; do
    grep -q "^#define $have 1" build/config.h || { error "configure: $have not set"; return 1; }
  done
  grep -q '^#define KDM_PAM_SERVICE "kde3"' build/config.h || { error "configure: PAM service"; return 1; }
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  local src=${_repo}-${_commit} root=${pkgdir}${_prefix}

  # Parts that are only built when their dependencies are found.
  local f
  for f in bin/kdm bin/kxkb bin/kfontinst bin/ksysguardd \
           lib/kde3/kio_smb.so lib/kde3/kio_ldap.so lib/kde3/exrthumbnail.so \
           lib/kde3/volume_panelapplet.so share/apps/kicker/applets/volumeapplet.desktop \
           lib/kde3/kpowermanager_panelapplet.so share/apps/kicker/applets/kpowermanager.desktop \
           lib/kde3/network_panelapplet.so share/apps/kicker/applets/networkapplet.desktop \
           bin/xdg-desktop-portal-kde3 share/xdg-desktop-portal/portals/kde3.portal \
           lib/kde3/kded_touchpad.so share/services/kded/touchpad.desktop \
           share/dbus-1/services/org.freedesktop.impl.portal.desktop.kde3.service \
           share/apps/konsole/fonts/fonts.dir \
           share/fontconfig/conf.avail/60-kde3-konsole-fonts.conf; do
    [[ -e ${root}/$f ]] || { error "not built: $f"; return 1; }
  done

  # The "install-exec-hook"s that only work when installing as root:
  # kcheckpass (password checks for kdesktop_lock) is setuid root, kdesud
  # (password cache of kdesu) setgid nobody.
  chmod 4755 "${root}/bin/kcheckpass"
  chgrp nobody "${root}/bin/kdesud"
  chmod 2755 "${root}/bin/kdesud"

  # PAM services (the install hooks run mkpamserv only without DESTDIR).
  install -Dm644 "${srcdir}/kde3.pam"    "${pkgdir}/etc/pam.d/kde3"
  install -Dm644 "${srcdir}/kde3-np.pam" "${pkgdir}/etc/pam.d/kde3-np"

  # "KDE 3.5" in the session list of display managers, and kdm as a
  # systemd service (it is not enabled; "systemctl enable kde3-kdm" makes
  # it the display manager).  The session file's DesktopNames=KDE3;GNOME;
  # becomes XDG_CURRENT_DESKTOP=KDE3:GNOME.
  install -Dm644 "${srcdir}/kde3.desktop" "${pkgdir}/usr/share/xsessions/kde3.desktop"
  install -Dm644 "${srcdir}/kde3-kdm.service" "${pkgdir}/usr/lib/systemd/system/kde3-kdm.service"

  # xdg-desktop-portal's backends for that desktop (kde3 and gtk for the
  # settings, gtk for the rest, gnome-keyring for secrets, none for what
  # needs GNOME Shell) instead of the gnome-portals.conf of the fallback
  # desktop, and KDE 3's own Settings backend xdg-desktop-portal-kde3 (its
  # kde3.portal and the session bus' service file): xdg-desktop-portal and
  # dbus-daemon do not search /opt/kde3.  Copies of what kdebase installs
  # in /opt/kde3/share.
  install -Dm644 "${root}/share/xdg-desktop-portal/kde3-portals.conf" \
    "${pkgdir}/usr/share/xdg-desktop-portal/kde3-portals.conf"
  install -Dm644 "${root}/share/xdg-desktop-portal/portals/kde3.portal" \
    "${pkgdir}/usr/share/xdg-desktop-portal/portals/kde3.portal"
  install -Dm644 "${root}/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kde3.service" \
    "${pkgdir}/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kde3.service"

  # Konsole's console fonts ("Linux", "Unicode") for fontconfig and so
  # Xft: fontconfig does not search the KDE data directory.
  install -dm755 "${pkgdir}/etc/fonts/conf.d"
  ln -s ../../..${_prefix}/share/fontconfig/conf.avail/60-kde3-konsole-fonts.conf \
    "${pkgdir}/etc/fonts/conf.d/60-kde3-konsole-fonts.conf"

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" ${src}/{COPYING,COPYING-DOCS}
}
