# Maintainer: Serghei Amelian <serghei.amelian@gmail.com>
#
# kdelibs 3.5.10 as maintained by kde3-revival, installed in /opt/kde3.
# Snapshot of a fixed commit; run ../../bump.sh kde3-kdelibs to move to the
# latest commit of the master branch (updates _commit, _date, pkgver,
# pkgrel and sha256sums).
#
# kde3-qt is not in a repository: build it first (../../build.sh does that
# with the packages in out/).

pkgname=kde3-kdelibs
_commit=bff1f449ec1abd03ba2a2b2fb2206ec79b975a46
_date=20261121
pkgver=3.5.10+git${_date}
pkgrel=1
pkgdesc='KDE 3.5 core libraries maintained for kde3-revival'
arch=(x86_64)
url='https://github.com/kde3-revival/kde3-kdelibs'
license=('LGPL-2.0-or-later AND GPL-2.0-or-later AND BSD-2-Clause AND GFDL-1.2-or-later')
# openssl is loaded at run time (KOpenSSLProxy); iceauth is run by
# dcopserver; perl runs dcopidlng (kde3_use_dcopidlng() of other modules),
# fileshareset and kconf_update scripts; libpng and zlib are needed by the
# CMake package (find_dependency()).
depends=(kde3-qt acl avahi bzip2 cairo fontconfig glib2 glibc krb5 libavif
         libcups libgcc libheif libice libidn libjpeg-turbo libjxl libpng libpsl
         libpulse librsvg libsm libsndfile libstdc++ libthai libtiff libutempter
         libwebp libx11 libxext libxft libxml2 libxrender libxslt openssl pcre
         perl xorg-iceauth zlib)
makedepends=(cmake ninja)
optdepends=('aspell: spell checking (KSpell)'
            'hspell: Hebrew spell checking (KSpell)'
            'cups: printing')
backup=(etc/profile.d/kde3.sh etc/profile.d/kde3.csh)
source=("kde3-kdelibs-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz"
        kde3.sh
        kde3.csh
        KDE3LibsConfig.cmake
        KDE3LibsConfigVersion.cmake)
sha256sums=('bffa417fa30bc78bc16f6406b1cd6815fae303f492eb77c7c4198a0863ba9d40'
            '8bc43d087aa2ac1aacecb27b038ad274d5298a0a8078fe87b544b561be038c17'
            '93f0ad67b86ae04c9460cdb31401ec89f5547dcd9788db3f2fbcddaccdb7e202'
            '6e72cca77496e941f7114654812862427ebc3f0c6e83a7d846f9bec7744a825e'
            'df4444bdd6a2cb8cbd8c472dbc877fddf58382f85934857ac264def5d25c9c81')

_prefix=/opt/kde3

build() {
  # CMAKE_BUILD_TYPE=None: the distribution flags only (the KDE build types
  # add -O2 -g or -DNDEBUG -DNO_DEBUG).  The libraries go into
  # /opt/kde3/lib (KDELIBSUFF empty), like kde3-qt's.  sysconfdir stays
  # /opt/kde3/etc (kderc, xdg/menus), so nothing clashes with the /etc/xdg
  # of KDE Plasma.  The PPD for CUPS is installed below, independent of
  # whether the build container has /usr/share/cups/model.
  cmake -S kde3-kdelibs-${_commit} -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=${_prefix} \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DKDELIBSUFF= \
    -DKDE3_QT_RPATH=/opt/kde3-qt/lib \
    -DKDE_DISTRIBUTION_TEXT='kde3-revival Arch Linux package' \
    -DKDE3_INSTALL_CUPS_PPD=OFF \
    -DKDE3_WITH_FAM=OFF \
    -DKDE3_WITH_LIBTHAI=ON
  # Fail instead of silently building without an optional feature.
  local have
  for have in HAVE_SSL HAVE_LIBIDN HAVE_LIBPSL HAVE_LIBGSSAPI HAVE_DNSSD \
              HAVE_PCREPOSIX HAVE_PULSEAUDIO HAVE_LIBTIFF HAVE_UTEMPTER \
              USE_POSIX_ACL HAVE_LIBTHAI HAVE_INOTIFY HAVE_CUPS HAVE_LIBRSVG; do
    grep -q "^#define $have 1" build/config.h || { error "configure: $have not set"; return 1; }
  done
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  local src=kde3-kdelibs-${_commit}

  # The setuid root helpers ("install-exec-hook"s that set the mode when
  # the installation may chown, as under fakeroot): kgrantpty (pty
  # ownership), start_kdeinit (OOM protection of kdeinit) and
  # kpac_dhcp_helper (binds the DHCP port for proxy autoconfiguration).
  # Not fileshareset: it is a Perl script, and Linux ignores the setuid bit
  # of scripts.
  local f
  for f in kgrantpty start_kdeinit kpac_dhcp_helper; do
    chmod 4755 "${pkgdir}${_prefix}/bin/$f"
  done
  chmod 0755 "${pkgdir}${_prefix}/bin/fileshareset"

  # The PostScript driver for CUPS ("install-data-local" of kdeprint/cups).
  install -Dm644 ${src}/kdeprint/cups/postscript.ppd.gz \
    "${pkgdir}/usr/share/cups/model/postscript.ppd.gz"

  # Environment and CMake package (see the files).
  install -Dm644 "${srcdir}/kde3.sh"  "${pkgdir}/etc/profile.d/kde3.sh"
  install -Dm644 "${srcdir}/kde3.csh" "${pkgdir}/etc/profile.d/kde3.csh"
  install -Dm644 -t "${pkgdir}/usr/lib/cmake/KDE3Libs" \
    "${srcdir}/KDE3LibsConfig.cmake" "${srcdir}/KDE3LibsConfigVersion.cmake"

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" \
    ${src}/{COPYING,COPYING.LIB,COPYING.BSD,COPYING-DOCS}
}
