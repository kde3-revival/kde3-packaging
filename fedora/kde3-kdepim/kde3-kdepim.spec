# kdepim 3.5.10 as maintained by kde3-revival, installed in /opt/kde3.
# Snapshot of a fixed commit; run ../../bump.sh kde3-kdepim to move to the
# latest commit of the master branch (updates commit, date, Release, the
# changelog and the "sources" checksum file).
#
# kde3-qt, kde3-kdelibs and kde3-kdebase are not in a repository: build
# them first (../../build.sh does that with the packages in out/).

%global commit     b12fbb9fa44f83422320bde0ec9597305829719a
%global shortcommit %(c=%{commit}; echo ${c:0:7})
%global date       20261120

%global kde3dir    /opt/kde3

Name:           kde3-kdepim
Version:        3.5.10+git%{date}
Release:        1%{?dist}
Summary:        KDE 3.5 PIM suite (KMail, KOrganizer, Kontact) maintained for kde3-revival

License:        GPL-2.0-or-later AND LGPL-2.0-or-later AND (LGPL-2.1-only OR MPL-1.0) AND GFDL-1.2-or-later
URL:            https://github.com/kde3-revival/kde3-kdepim
Source0:        %{url}/archive/%{commit}.tar.gz#/%{name}-%{commit}.tar.gz

BuildRequires:  cmake
BuildRequires:  ninja-build
BuildRequires:  gcc-c++
BuildRequires:  kde3-kdelibs-devel
# libical's sources are generated by Perl scripts.
BuildRequires:  perl-interpreter
BuildRequires:  perl(Getopt::Std)
BuildRequires:  perl(lib)
BuildRequires:  perl(strict)
BuildRequires:  perl(warnings)
BuildRequires:  cyrus-sasl-devel
BuildRequires:  gpgme-devel
BuildRequires:  libgpg-error-devel
BuildRequires:  zlib-devel

Requires:       kde3-kdelibs%{?_isa}
# The ioslaves KMail and KAddressBook use for POP3, SMTP and LDAP
# (kio_pop3, kio_smtp, kio_ldap; imap4, sieve and mbox are kdepim's own).
Requires:       kde3-kdebase%{?_isa}
# The crypto backends of KMail and Kleopatra run gpg, gpgsm and gpg-agent,
# through gpgme and, for the classic OpenPGP support of KMail (libkpgp),
# directly; gpgsm (S/MIME) is in gnupg2-smime.
Requires:       gnupg2
Recommends:     gnupg2-smime
Recommends:     pinentry
# The anti-spam and anti-virus wizards of KMail look for these.
Suggests:       spamassassin
Suggests:       clamav

%description
kdepim 3.5.10 as maintained by the kde3-revival project: the personal
information management programs of KDE 3.5 -- the mail client KMail, the
calendar and to-do manager KOrganizer, the address book KAddressBook,
Kontact, which combines them, the certificate manager Kleopatra,
KWatchGnuPG and KMailCvt -- with the imap4, sieve and mbox ioslaves and
the libraries they share (libkcal, libkmime, mimelib, libkdepim, gpgme++,
Kleo).  It is installed in %{kde3dir} and does not conflict with the KDE
PIM of KDE Gear.

%package devel
Summary:        Development files for kde3-kdepim
Requires:       %{name}%{?_isa} = %{version}-%{release}
Requires:       kde3-kdelibs-devel%{?_isa}
Requires:       gpgme-devel

%description devel
Headers and the unversioned links of the shared libraries of kdepim
(libkcal, libkmime, mimelib, libkdepim, libkpimidentities, gpgme++, Kleo,
the Kontact and KOrganizer plugin interfaces) for building plugins and
programs against them.


%prep
%autosetup -n %{name}-%{commit}

%build
# The prefix, the library directory (/opt/kde3/lib) and the RUNPATH come
# from kdelibs' CMake package (CMAKE_INSTALL_PREFIX given to %%cmake is
# overridden here, the LIB_SUFFIX of %%cmake is not used).
# CMAKE_BUILD_TYPE=None: the distribution flags only.  cyrus-sasl is
# required (the sieve ioslave, the authentication methods of imap4);
# gnokii (mobile phones in KAddressBook) is not used, indexlib (KMail's
# full-text index) is experimental and off by default.
%cmake \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=%{kde3dir} \
    -DKDEPIM_WITH_SASL=ON \
    -DKDEPIM_WITH_GNOKII=OFF \
    -DKDEPIM_INDEXLIB=OFF
# Fail instead of silently building without an optional feature.
for have in HAVE_LIBSASL2 HAVE_INOTIFY HAVE_GPGME_0_4_BRANCH HAVE_GPGME_CANCEL \
            HAVE_GPGME_INCLUDE_CERTS_DEFAULT HAVE_GPGME_KEYLIST_MODE_VALIDATE \
            HAVE_GPGME_KEY_T_KEYLIST_MODE HAVE_GPGME_OP_GETAUDITLOG \
            HAVE_GPGME_WRONG_KEY_USAGE KDEPIM_NEW_DISTRLISTS; do
    grep -q "^#define $have 1" %{__cmake_builddir}/config.h || { echo "configure: $have not set" >&2; exit 1; }
done
%cmake_build

%install
# The RUNPATHs have, besides $ORIGIN, the absolute /opt/kde3/lib and
# /opt/kde3-qt/lib, which check-rpaths calls "invalid" (anything outside
# /usr/lib*).
export QA_RPATHS=$((0x0002))
%cmake_install

root=%{buildroot}%{kde3dir}

# Parts that are only built when their dependencies are found.
for f in bin/kmail bin/korganizer bin/kaddressbook bin/kontact bin/kleopatra \
         lib/kde3/kio_imap4.so lib/kde3/kio_sieve.so lib/kde3/kio_mbox.so; do
    [ -e $root/$f ] || { echo "not built: $f" >&2; exit 1; }
done

# The service of the gnokii filter is installed although its module is
# only built with gnokii: KAddressBook would offer an import/export it
# cannot load.
rm $root/share/services/kaddressbook/gnokii_xxport.desktop

cp -p korganizer/COPYING COPYING
cp -p libkcal/COPYING COPYING.LIB
cp -p kontact/pics/icons/LICENSE LICENSE.kontact-icons

# The file lists of the tree in /opt/kde3: the headers, the unversioned
# links of the shared libraries and indexlib-config (compiler flags for
# libindex) go into -devel, everything else into the main package.  Directories that kde3-kdelibs and
# kde3-kdebase have (installed for the build) are left to them.
(
    cd %{buildroot}
    find .%{kde3dir} -type d | sed 's|^\.||' | while read -r d; do
        [ -d "$d" ] || echo "%%dir \"$d\""
    done
    find .%{kde3dir} ! -type d | sed 's|^\.\(.*\)$|"\1"|'
) | awk -v k=%{kde3dir} -v devel=devel.list -v main=main.list \
        -v solinks="$(cd %{buildroot} && find .%{kde3dir}/lib -maxdepth 1 -name 'lib*.so' -type l | sed 's|^\.||' | tr '\n' ' ')" '
    BEGIN { m = split(solinks, s, " "); for (i = 1; i <= m; i++) so[s[i]] = 1 }
    {
        path = $0; sub(/^%%dir /, "", path); gsub(/"/, "", path)
        out = main
        if (index(path, k "/include/") == 1 || path in so || path == k "/bin/indexlib-config")
            out = devel
        print >out
    }'
sort -o main.list main.list
sort -o devel.list devel.list


%files -f main.list
%license COPYING COPYING.LIB LICENSE.kontact-icons
%doc README README.Kolab

%files devel -f devel.list

